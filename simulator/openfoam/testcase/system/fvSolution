FoamFile
{
    version    2.0;
    format    ascii;
    class    dictionary;
    object    fvSolution;
}


solvers
{
    U
    {
        solver    PBiCG;
        preconditioner    DILU;
        tolerance    1e-08;
        relTol    0.01;
        smoother    GaussSeidel;

    }
    p
    {
        solver    GAMG;
        preconditioner    DILU;
        tolerance    1e-06;
        relTol    0.001;
        smoother    symGaussSeidel;

    }
}

SIMPLE
{
    nNonOrthogonalCorrectors    1;
    consistent    yes;
    pRefCell    0;
    pRefValue    0;
    residualControl
    {
        p    0.000001;
        U    0.000001;

    }
}

relaxationFactors
{
    fields
    {
        p    0.3;

    }
    equations
    {
        U    0.7;

    }
}

